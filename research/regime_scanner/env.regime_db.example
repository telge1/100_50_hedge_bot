# Example environment for the regime scanner MySQL candle store.
# Copy values into a local untracked `.env` / shell export. Do not commit secrets.

REGIME_DB_HOST=127.0.0.1
REGIME_DB_PORT=3306
REGIME_DB_NAME=regime_scanner_research
REGIME_DB_USER=regime_scanner
REGIME_DB_PASSWORD=change_me

