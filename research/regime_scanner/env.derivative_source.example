# Example environment for the READ-ONLY derivatives source DB.
# Copy to a local untracked file, e.g. research/regime_scanner/.env.derivative_source
# Do NOT commit real secrets. Do NOT reuse liq_collector / writer credentials.

DERIVATIVE_SOURCE_DB_HOST=127.0.0.1
DERIVATIVE_SOURCE_DB_PORT=3306
DERIVATIVE_SOURCE_DB_NAME=liquidation_research
DERIVATIVE_SOURCE_DB_USER=derivatives_ro
DERIVATIVE_SOURCE_DB_PASSWORD=change_me

# Backend: pymysql (SQLAlchemy) or cli (mysql client; useful for local socket auth)
DERIVATIVE_SOURCE_DB_BACKEND=pymysql
# DERIVATIVE_SOURCE_DB_CONNECT_TIMEOUT=15

# Target research DB remains separate (see env.regime_db.example):
# REGIME_DB_HOST / REGIME_DB_PORT / REGIME_DB_NAME / REGIME_DB_USER / REGIME_DB_PASSWORD
