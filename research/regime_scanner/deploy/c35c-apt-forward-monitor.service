[Unit]
Description=C3.5c APTUSDT 15m A6 paper-forward monitor (run-once)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/telgenbuescher/projects/spread_recovery_hedge_short_dev
Environment=PYTHONPATH=/home/telgenbuescher/projects/spread_recovery_hedge_short_dev
ExecStart=/home/telgenbuescher/miniconda3/bin/python3 -m research.regime_scanner.pullback_entry_c3_5c_apt_forward_monitor run-once --log-level INFO
Nice=10
# Locking is handled inside the monitor (.monitor.lock). Do not overlap timers.

[Install]
WantedBy=multi-user.target
