{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bt_d6_strategy_backtest_config_v1.schema.json",
  "title": "BT-D6 Pool Landscape Strategy + Backtest Config V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "strategy_identity",
    "density",
    "short_entry",
    "risk",
    "take_profit",
    "pnl",
    "backtest"
  ],
  "properties": {
    "config_version": { "const": "bt_d6_strategy_backtest_config_v1" },
    "strategy_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_id",
        "strategy_version",
        "frozen_source_reference",
        "research_mode"
      ],
      "properties": {
        "strategy_id": { "type": "string", "minLength": 1 },
        "strategy_version": { "type": "string", "minLength": 1 },
        "frozen_source_reference": { "type": "string", "minLength": 1 },
        "research_mode": {
          "type": "string",
          "enum": ["depth2_density_research_v1", "config_experiment_v1"]
        }
      }
    },
    "density": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeframe", "pool_detail", "method", "min_unique_origins"],
      "properties": {
        "timeframe": { "const": "5m" },
        "pool_detail": { "const": 1 },
        "method": { "const": "exact_unique_origin" },
        "min_unique_origins": { "const": 2 },
        "density_source": {
          "type": "string",
          "enum": ["canonical_provider", "validated_cache"]
        },
        "validated_cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bundle_path"],
          "properties": {
            "bundle_path": { "type": "string" },
            "required_config_hash": { "type": "string" }
          }
        }
      }
    },
    "short_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_pool_selection_mode",
        "entry_price_reference",
        "pool_min_age_bars",
        "upper_gap_min_pct",
        "upper_gap_measurement_mode",
        "upper_pool_proximity_pct",
        "pending_limit_enabled",
        "pending_limit_expiry_bars"
      ],
      "properties": {
        "entry_pool_selection_mode": {
          "type": "string",
          "enum": ["nearest_upper_proximity_v1", "pool_first_structural_v1", "user_relevant_upper_unresolved"]
        },
        "pool_cancel_identity_mode": {
          "type": "string",
          "enum": ["exact_band_v1", "origin_set_v1"]
        },
        "entry_price_reference": {
          "type": "string",
          "enum": ["upper_pool_lower_edge", "upper_pool_upper_edge"]
        },
        "entry_offset_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "pool_min_age_bars": { "type": "integer", "minimum": 0, "maximum": 500 },
        "upper_gap_min_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "upper_gap_measurement_mode": {
          "type": "string",
          "enum": ["adjacent_union_interval_gap_pct_v1"]
        },
        "upper_pool_proximity_pct": { "type": "number", "minimum": 0, "maximum": 10 },
        "pending_limit_enabled": { "type": "boolean" },
        "pending_limit_expiry_bars": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100000
        },
        "pending_limit_fill_model": {
          "type": "string",
          "enum": ["legacy_v1", "causal_sell_limit_v2"]
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sl_above_upper_top_pct", "max_concurrent_positions"],
      "properties": {
        "sl_above_upper_top_pct": { "type": "number", "minimum": 0, "maximum": 10 },
        "max_concurrent_positions": { "type": "integer", "const": 1 }
      }
    },
    "take_profit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_mode",
        "min_distance_pct",
        "distance_reference",
        "dense_cluster_semantics_approved"
      ],
      "properties": {
        "selection_mode": {
          "type": "string",
          "enum": ["next_eligible_band", "dense_cluster"]
        },
        "min_distance_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "distance_reference": {
          "type": "string",
          "enum": ["actual_fill_to_lower_upper_edge"]
        },
        "dense_cluster_semantics_approved": { "type": "boolean" },
        "tp_pool_quality_gate_enabled": { "type": "boolean" }
      }
    },
    "pnl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_equity_usdt",
        "sizing_mode",
        "position_notional_usdt",
        "risk_fraction_pct",
        "leverage",
        "trading_fee_model",
        "slippage_model",
        "funding_model",
        "intrabar_ambiguity_policy",
        "end_of_test_open_position_policy"
      ],
      "properties": {
        "initial_equity_usdt": { "type": "number", "exclusiveMinimum": 0 },
        "sizing_mode": {
          "type": "string",
          "enum": ["fixed_notional_usdt", "risk_fraction_of_equity"]
        },
        "position_notional_usdt": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "risk_fraction_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "leverage": { "type": "number", "minimum": 1, "maximum": 125 },
        "trading_fee_model": { "$ref": "#/$defs/fee_model" },
        "slippage_model": { "$ref": "#/$defs/slippage_model" },
        "funding_model": { "$ref": "#/$defs/funding_model" },
        "intrabar_ambiguity_policy": {
          "type": "string",
          "enum": ["no_trade_ambiguous", "conservative_sl_first_unresolved"]
        },
        "end_of_test_open_position_policy": {
          "type": "string",
          "enum": ["mark_unrealized_at_last_close", "exclude_from_realized_pnl"]
        }
      }
    },
    "backtest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbols",
        "start_utc",
        "end_utc",
        "execution_timeframe",
        "outcome_blind_signals",
        "deterministic_seed"
      ],
      "properties": {
        "symbols": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "start_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "end_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "execution_timeframe": { "const": "5m" },
        "outcome_blind_signals": { "type": "boolean" },
        "deterministic_seed": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "fee_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "roundtrip_pct"],
      "properties": {
        "model": { "const": "roundtrip_pct_of_notional" },
        "roundtrip_pct": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    },
    "slippage_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "entry_slippage_pct", "exit_slippage_pct"],
      "properties": {
        "model": { "enum": ["none", "pct_of_notional_per_side"] },
        "entry_slippage_pct": { "type": "number", "minimum": 0, "maximum": 5 },
        "exit_slippage_pct": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    },
    "funding_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "funding_rate_bps_per_8h"],
      "properties": {
        "model": { "enum": ["none", "constant_bps_per_8h_short"] },
        "funding_rate_bps_per_8h": { "type": "number", "minimum": 0, "maximum": 500 }
      }
    }
  }
}
