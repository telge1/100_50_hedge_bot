# OB1000 on-demand (default false; set true for live pilot)
OB_V3_ON_DEMAND_ENABLE=false
OB_V3_ON_DEMAND_SOCKET_PATH=/run/user/1000/orderbook_ob1000.sock
OB_V3_ON_DEMAND_MAX_ACTIVE=4
