[Unit]
Description=Bybit linear OI + allLiquidation collector (no orderbook, no trading)
After=network-online.target docker.service
Wants=network-online.target
# Fail-fast exits (writer dead / persistence lag / spool full) should restart,
# but not spin forever on a permanent misconfiguration.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/telgenbuescher/projects/orderbook_analyse
Environment=PYTHONPATH=src
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/telgenbuescher/projects/orderbook_analyse/.env
ExecStart=/home/telgenbuescher/projects/orderbook_analyse/.venv/bin/python -m orderbook_analyse.oi_liquidation_collector --mode live --duration 0
# on-failure: process must exit nonzero when writer dies (new supervision).
# Do not use Restart=always alone as a substitute for health checks.
# Prefer always so OOM/SIGKILL/unexpected exit 0 still come back quickly.
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=append:/home/telgenbuescher/projects/orderbook_analyse/logs/oi_liquidation_live.log
StandardError=append:/home/telgenbuescher/projects/orderbook_analyse/logs/oi_liquidation_live.log
# WatchdogSec intentionally omitted until sd_notify is implemented and tested.

[Install]
WantedBy=default.target
